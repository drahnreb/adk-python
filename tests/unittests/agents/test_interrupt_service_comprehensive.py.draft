"""Comprehensive tests for InterruptService functionality.

Tests core interrupt service features:
- Session registration/unregistration
- Message queueing and retrieval
- Pause/resume functionality
- Cancellation
- Queue management
- Session eviction
"""

import asyncio
import pytest
from typing import Any, Dict

from google.adk.agents.graph.interrupt_service import (
    InterruptService,
    InterruptServiceConfig,
    InterruptMessage,
    QueueStatus,
)


class TestSessionManagement:
    """Test session lifecycle management."""

    def test_register_session(self):
        """Test session registration creates required resources."""
        service = InterruptService()
        session_id = "test-session-1"

        service.register_session(session_id)

        assert service.is_active(session_id)
        assert not service.is_paused(session_id)

    def test_unregister_session(self):
        """Test session unregistration cleans up resources."""
        service = InterruptService()
        session_id = "test-session-1"

        service.register_session(session_id)
        service.unregister_session(session_id)

        assert not service.is_active(session_id)

    def test_double_register_is_idempotent(self):
        """Test that registering twice doesn't cause issues."""
        service = InterruptService()
        session_id = "test-session-1"

        service.register_session(session_id)
        service.register_session(session_id)  # Should not raise

        assert service.is_active(session_id)

    def test_context_manager(self):
        """Test context manager properly registers/unregisters."""
        service = InterruptService()
        session_id = "test-session-1"

        with service.session(session_id):
            assert service.is_active(session_id)

        assert not service.is_active(session_id)


class TestMessageQueue:
    """Test message queueing and retrieval."""

    @pytest.mark.asyncio
    async def test_send_and_check_message(self):
        """Test sending and checking messages."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        # Send message
        await service.send_message(
            session_id=session_id,
            text="Test message",
            metadata={"key": "value"},
            action="test_action",
        )

        # Check message
        message = await service.check_interrupt(session_id)
        assert message is not None
        assert message.text == "Test message"
        assert message.metadata == {"key": "value"}
        assert message.action == "test_action"

    @pytest.mark.asyncio
    async def test_check_interrupt_removes_message(self):
        """Test that check_interrupt removes message from queue."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.send_message(session_id=session_id, text="Message 1")
        await service.send_message(session_id=session_id, text="Message 2")

        # First check gets first message
        msg1 = await service.check_interrupt(session_id)
        assert msg1.text == "Message 1"

        # Second check gets second message
        msg2 = await service.check_interrupt(session_id)
        assert msg2.text == "Message 2"

        # Third check gets nothing
        msg3 = await service.check_interrupt(session_id)
        assert msg3 is None

    @pytest.mark.asyncio
    async def test_send_message_to_unregistered_session(self):
        """Test sending message to unregistered session silently succeeds."""
        service = InterruptService()

        # Should not raise
        await service.send_message(
            session_id="nonexistent", text="Test"
        )

    @pytest.mark.asyncio
    async def test_queue_size_limit(self):
        """Test queue respects max_queue_size limit."""
        config = InterruptServiceConfig(max_queue_size=2)
        service = InterruptService(config)
        session_id = "test-session-1"
        service.register_session(session_id)

        # Fill queue
        await service.send_message(session_id=session_id, text="Msg 1")
        await service.send_message(session_id=session_id, text="Msg 2")

        # Third message should timeout
        with pytest.raises(asyncio.TimeoutError):
            await service.send_message(
                session_id=session_id, text="Msg 3", timeout=0.1
            )


class TestPauseResume:
    """Test pause and resume functionality."""

    @pytest.mark.asyncio
    async def test_pause_sets_paused_state(self):
        """Test pause sets session to paused."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.pause(session_id)

        assert service.is_paused(session_id)

    @pytest.mark.asyncio
    async def test_resume_clears_paused_state(self):
        """Test resume clears paused state."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.pause(session_id)
        await service.resume(session_id)

        assert not service.is_paused(session_id)

    @pytest.mark.asyncio
    async def test_wait_if_paused_blocks_when_paused(self):
        """Test wait_if_paused blocks until resumed."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.pause(session_id)

        # Resume after delay
        async def resume_after_delay():
            await asyncio.sleep(0.1)
            await service.resume(session_id)

        resume_task = asyncio.create_task(resume_after_delay())

        # wait_if_paused should block until resumed
        result = await service.wait_if_paused(session_id, timeout=1.0)
        assert result is True  # True means resumed normally

        await resume_task

    @pytest.mark.asyncio
    async def test_wait_if_paused_returns_immediately_if_not_paused(self):
        """Test wait_if_paused returns immediately when not paused."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        # Should return immediately
        result = await service.wait_if_paused(session_id, timeout=0.1)
        assert result is True


class TestCancellation:
    """Test cancellation functionality."""

    @pytest.mark.asyncio
    async def test_cancel_sets_cancellation_flag(self):
        """Test cancel sets internal cancellation event."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.cancel(session_id)

        # wait_if_paused should return False when cancelled
        await service.pause(session_id)
        result = await service.wait_if_paused(session_id, timeout=0.1)
        assert result is False  # False means cancelled

    @pytest.mark.asyncio
    async def test_cancel_clears_queue(self):
        """Test cancel clears message queue."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.send_message(session_id=session_id, text="Msg 1")
        await service.send_message(session_id=session_id, text="Msg 2")

        await service.cancel(session_id)

        # Queue should be empty
        status = service.get_queue_status(session_id)
        assert status.size == 0


class TestQueueManagement:
    """Test queue status and management."""

    def test_get_queue_status(self):
        """Test get_queue_status returns accurate info."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        status = service.get_queue_status(session_id)
        assert status is not None
        assert status.size == 0
        assert status.max_size == 100  # default

    @pytest.mark.asyncio
    async def test_list_queued_messages(self):
        """Test list_queued_messages shows messages without removing."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        await service.send_message(session_id=session_id, text="Msg 1")
        await service.send_message(session_id=session_id, text="Msg 2")

        messages = service.list_queued_messages(session_id)
        assert len(messages) == 2
        assert messages[0].text == "Msg 1"
        assert messages[1].text == "Msg 2"

        # Messages should still be in queue
        status = service.get_queue_status(session_id)
        assert status.size == 2

    def test_clear_queue(self):
        """Test clear_queue removes all messages."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        # Manually add messages to queue (can't use send_message in sync test)
        service._message_queues[session_id].put_nowait(
            InterruptMessage(text="Msg 1", metadata={}, action=None)
        )
        service._message_queues[session_id].put_nowait(
            InterruptMessage(text="Msg 2", metadata={}, action=None)
        )

        cleared_count = service.clear_queue(session_id)
        assert cleared_count == 2

        status = service.get_queue_status(session_id)
        assert status.size == 0


class TestSessionEviction:
    """Test session eviction policies."""

    def test_evict_oldest_sessions(self):
        """Test evicting oldest sessions."""
        service = InterruptService()

        # Register multiple sessions
        service.register_session("session-1")
        service.register_session("session-2")
        service.register_session("session-3")

        # Evict to keep only 1
        service.evict_oldest_sessions(max_to_keep=1)

        # Only newest should remain
        assert service.is_active("session-3")
        assert not service.is_active("session-1")
        assert not service.is_active("session-2")

    @pytest.mark.asyncio
    async def test_evict_inactive_sessions(self):
        """Test evicting inactive sessions."""
        config = InterruptServiceConfig(session_inactive_timeout=0.1)
        service = InterruptService(config)

        service.register_session("session-1")

        # Wait for session to become inactive
        await asyncio.sleep(0.2)

        # Evict inactive
        service.evict_inactive_sessions(max_age_seconds=0.1)

        # Session should be gone
        assert not service.is_active("session-1")


class TestValidation:
    """Test input validation."""

    @pytest.mark.asyncio
    async def test_invalid_session_id_format(self):
        """Test that invalid session ID format is rejected."""
        service = InterruptService()

        with pytest.raises(ValueError, match="Session ID must be non-empty"):
            service.register_session("")

    @pytest.mark.asyncio
    async def test_invalid_message_text(self):
        """Test that empty message text is rejected."""
        service = InterruptService()
        session_id = "test-session-1"
        service.register_session(session_id)

        with pytest.raises(ValueError, match="Message text cannot be empty"):
            await service.send_message(session_id=session_id, text="")

    @pytest.mark.asyncio
    async def test_message_text_too_long(self):
        """Test that oversized message text is rejected."""
        config = InterruptServiceConfig(max_message_size=100)
        service = InterruptService(config)
        session_id = "test-session-1"
        service.register_session(session_id)

        long_text = "x" * 101

        with pytest.raises(ValueError, match="exceeds maximum"):
            await service.send_message(session_id=session_id, text=long_text)


class TestMetrics:
    """Test metrics collection."""

    @pytest.mark.asyncio
    async def test_metrics_track_operations(self):
        """Test that metrics are collected when enabled."""
        config = InterruptServiceConfig(enable_metrics=True)
        service = InterruptService(config)
        session_id = "test-session-1"
        service.register_session(session_id)

        # Perform operations
        await service.pause(session_id)
        await service.resume(session_id)
        await service.send_message(session_id=session_id, text="Test")

        # Check metrics exist
        assert session_id in service._session_metrics
        metrics = service._session_metrics[session_id]
        assert metrics.pause_count == 1
        assert metrics.resume_count == 1
        assert metrics.messages_queued == 1
