"""Comprehensive tests for parallel execution state merging.

Tests parallel execution state management:
- Deep copy isolation between branches
- State merge after parallel completion  
- Conflict detection and resolution
- Error handling during parallel execution
"""

import pytest
from copy import deepcopy

from google.adk.agents.base_agent import BaseAgent
from google.adk.agents.graph import GraphAgent, GraphNode, GraphState
from google.adk.agents.graph.parallel import ParallelNodeGroup, JoinStrategy, ErrorPolicy
from google.adk.events.event import Event
from google.adk.runners import Runner
from google.adk.sessions.in_memory_session_service import InMemorySessionService
from google.genai import types


class StatefulTestAgent(BaseAgent):
    """Test agent that modifies state."""
    
    model_config = {"extra": "allow", "arbitrary_types_allowed": True}
    
    def __init__(self, name: str, response: str):
        super().__init__(name=name)
        object.__setattr__(self, "_response", response)
    
    async def _run_async_impl(self, ctx):
        response = object.__getattribute__(self, "_response")
        yield Event(
            author=self.name,
            content=types.Content(parts=[types.Part(text=response)])
        )


@pytest.mark.asyncio
async def test_deep_copy_isolation():
    """Test that nested structures are truly isolated in parallel branches."""
    original_state = GraphState(
        data={"results": [1, 2, 3], "meta": {"count": 0}},
        metadata={}
    )
    
    # Simulate parallel execution deep copy
    branch1 = GraphState(
        data=deepcopy(original_state.data),
        metadata=deepcopy(original_state.metadata)
    )
    branch2 = GraphState(
        data=deepcopy(original_state.data),
        metadata=deepcopy(original_state.metadata)
    )
    
    # Modify branches
    branch1.data["results"].append(4)
    branch2.data["results"].append(5)
    
    # Original unchanged
    assert original_state.data["results"] == [1, 2, 3]
    assert branch1.data["results"] == [1, 2, 3, 4]
    assert branch2.data["results"] == [1, 2, 3, 5]


@pytest.mark.asyncio
async def test_parallel_execution_basic():
    """Test basic parallel execution with state merge."""
    session_service = InMemorySessionService()
    
    graph = GraphAgent(name="test_graph")
    
    agent1 = StatefulTestAgent("agent1", "response1")
    agent2 = StatefulTestAgent("agent2", "response2")
    
    graph.add_node(GraphNode(name="node1", agent=agent1))
    graph.add_node(GraphNode(name="node2", agent=agent2))
    graph.set_start("node1")
    
    graph.add_parallel_group(
        ParallelNodeGroup(nodes=["node1", "node2"], join_strategy=JoinStrategy.WAIT_ALL)
    )
    
    runner = Runner(
        app_name="test_app",
        agent=graph,
        session_service=session_service,
        auto_create_session=True
    )
    
    events = []
    async for event in runner.run_async(
        user_id="test_user",
        session_id="test_session",
        new_message=types.Content(parts=[types.Part(text="start")])
    ):
        if event.content and event.content.parts:
            events.append(event.content.parts[0].text)
    
    # Both agents should execute
    event_text = " ".join(events)
    assert "response1" in event_text
    assert "response2" in event_text


@pytest.mark.asyncio
async def test_parallel_wait_any_strategy():
    """Test WAIT_ANY completes after first branch."""
    session_service = InMemorySessionService()
    
    graph = GraphAgent(name="test_graph")
    
    agent1 = StatefulTestAgent("agent1", "first")
    agent2 = StatefulTestAgent("agent2", "second")
    
    graph.add_node(GraphNode(name="node1", agent=agent1))
    graph.add_node(GraphNode(name="node2", agent=agent2))
    graph.set_start("node1")
    
    graph.add_parallel_group(
        ParallelNodeGroup(nodes=["node1", "node2"], join_strategy=JoinStrategy.WAIT_ANY)
    )
    
    runner = Runner(
        app_name="test_app",
        agent=graph,
        session_service=session_service,
        auto_create_session=True
    )
    
    events = []
    async for event in runner.run_async(
        user_id="test_user",
        session_id="test_session",
        new_message=types.Content(parts=[types.Part(text="start")])
    ):
        if event.content and event.content.parts:
            events.append(event.content.parts[0].text)
    
    # At least one should execute
    assert len(events) > 0
